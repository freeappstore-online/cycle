{
  "name": "cycle",
  "description": "A private period tracker. Your data stays on your device unless you turn on encrypted sync.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/cycle.git"
  },
  "scripts": {
    "dev": "pnpm --filter @cycle/web dev",
    "build": "pnpm --filter @cycle/web build",
    "preview": "pnpm --filter @cycle/web preview",
    "typecheck": "pnpm --filter @cycle/web exec tsc -b && pnpm --filter @cycle/web exec tsc -p ../e2e",
    "test": "pnpm --filter @cycle/web test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "playwright": "1.64.1"
  }
}
